; 무협 가로판 (Godot 4.6)
config_version=5

[application]

config/name="무협 가로판"
config/version="0.4"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.063, 0.094, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=440
window/size/viewport_height=822
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.043, 0.063, 0.094, 1)
